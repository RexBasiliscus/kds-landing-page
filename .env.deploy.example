# cPanel SFTP Deployment Configuration
# Copy this file to .env.deploy and fill in your credentials
# .env.deploy is git-ignored for security

# SFTP Host (your domain or cPanel IP)
SFTP_HOST=your.domain.com

# SFTP Username (usually your cPanel username)
SFTP_USERNAME=your_cpanel_username

# SFTP Password (leave empty if using SSH key authentication)
SFTP_PASSWORD=your_password

# SFTP Port (usually 22 for SSH, sometimes 2222)
SFTP_PORT=22

# Remote path to public_html on your cPanel server
# Usually: /home/cpanel_username/public_html
REMOTE_PATH=/home/username/public_html
