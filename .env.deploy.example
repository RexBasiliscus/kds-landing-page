# Production SFTP connection. Copy this file to .env.deploy and keep it private.
SFTP_HOST=your-production-host
SFTP_PORT=your-ssh-port
SFTP_USERNAME=your-ssh-user
SFTP_REMOTE_PATH=/home/your-ssh-user/public_html

# Pin the server identity. Update only after verifying a legitimate host-key change.
SFTP_HOST_FINGERPRINT=SHA256:verified-server-fingerprint

# Prefer an SSH key. Windows paths may use forward slashes.
SFTP_PRIVATE_KEY_PATH=C:/Users/your-user/.ssh/production_deploy
# SFTP_PRIVATE_KEY_PASSPHRASE=

# Password authentication is supported as a fallback. Do not commit it.
# SFTP_PASSWORD=
